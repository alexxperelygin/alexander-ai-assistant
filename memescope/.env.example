# ===== MemeScope AI — environment =====
# Copy to .env and fill in. NEVER commit .env. NEVER put a seed phrase or
# private key anywhere in this project — the app must not custody funds.

# Database. Default: local SQLite (zero setup). For production use PostgreSQL:
# 1) change provider to "postgresql" in prisma/schema.prisma
# 2) set DATABASE_URL=postgresql://user:pass@localhost:5432/memescope
# 3) run: npx prisma migrate dev
DATABASE_URL="file:./dev.db"

# Data mode: "live" uses real public APIs (no keys required for the core set),
# "mock" uses the deterministic mock provider (clearly labeled in the UI).
DATA_MODE=live

# --- Optional API keys (system works without them; adapters activate if set) ---
# Birdeye (paid tiers; richer holder/trade data): https://docs.birdeye.so
BIRDEYE_API_KEY=
# Helius (free tier available; RPC + DAS holder data): https://docs.helius.dev
HELIUS_API_KEY=
# Custom Solana RPC endpoint (default: public mainnet-beta, heavily rate-limited)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Notifications (optional) ---
# Create a bot via @BotFather, put the token here, and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Worker tuning ---
SCAN_INTERVAL_SEC=60
MONITOR_INTERVAL_SEC=30
MAX_CANDIDATES_PER_CYCLE=8

# --- X (Twitter) API v2, платный источник ---
# Без ключа система работает как раньше: социальных данных просто нет.
# Ключ выдаётся в developer.x.com → Projects & Apps → Keys and tokens → Bearer Token.
X_BEARER_TOKEN=
# Месячный потолок прочитанных постов. Ставьте с запасом к тарифу: перерасход
# на платном плане означает счёт или блокировку до конца периода.
X_MONTHLY_POST_BUDGET=9000
# Дневной потолок. При оплате по факту (pay-per-use) он важнее месячного:
# ограничивает цену любой ошибки одними сутками, а не всем балансом.
X_DAILY_POST_BUDGET=400
# Постов за один запрос (минимум API — 10).
X_MAX_RESULTS=10
